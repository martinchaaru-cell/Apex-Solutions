# Copy to .env and fill in. Never commit .env (Baseline D2).
APP_ENV=production
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-value-of-at-least-32-characters

POSTGRES_DB=apex
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://apex:change-me@db:5432/apex

RATELIMIT_STORAGE_URI=redis://redis:6379/0
CONTACT_RATE_LIMIT=5 per hour;20 per day
COOKIE_SECURE=true
SITE_URL=https://apexsolutions.co.ke

# Public contact details. Leave blank to hide them on the site.
CONTACT_EMAIL=
CONTACT_PHONE=
WHATSAPP_NUMBER=
LOCATION_TEXT=Based in Kenya. Working with clients on site and remotely.
SECURITY_CONTACT=

# Optional email notification for new enquiries
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

ENQUIRY_RETENTION_DAYS=730

# Documents (admin uploads). Stored in instance/documents unless set.
MAX_DOCUMENT_MB=20
# DOCUMENTS_FOLDER=
LOGIN_RATE_LIMIT=10 per minute;50 per hour
